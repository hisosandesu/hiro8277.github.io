# Sentry エラー監視 (NH3)
# 取得方法: https://sentry.io でプロジェクト作成 → Settings > Client Keys (DSN)
# このファイルをコピーして .env.local を作成し、実際の DSN を設定してください
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXXXXXXXXXXXX.ingest.us.sentry.io/XXXXXXXXXXXXXXXXX

# Google Cloud Vision API キー (OCR Phase 4B)
# 取得方法: Google Cloud Console → APIs & Services → Credentials → APIキー作成
#   → Cloud Vision API を有効化 → HTTPリファラー制限を推奨
# 設定すると Cloud Vision API が主エンジンになり ML Kit はオフライン時フォールバック
# 未設定の場合は ML Kit のみ使用（オフライン動作）
# 無料枠: 月1000回 → 超過後 $1.50/1000回
EXPO_PUBLIC_CLOUD_VISION_API_KEY=your_cloud_vision_api_key_here
