# Sentry エラー監視 (NH3)
# 取得方法: https://sentry.io でプロジェクト作成 → Settings > Client Keys (DSN)
# このファイルをコピーして .env.local を作成し、実際の DSN を設定してください
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXXXXXXXXXXXX.ingest.us.sentry.io/XXXXXXXXXXXXXXXXX

# Google Cloud Vision API キー (OCR Phase 4B)
# 取得方法: Google Cloud Console → APIs & Services → Credentials → APIキー作成
#   → Cloud Vision API を有効化 → Android アプリ制限を推奨
# 設定すると Cloud Vision API が主エンジンになり ML Kit はオフライン時フォールバック
# 未設定の場合は ML Kit のみ使用（オフライン動作）
# 無料枠: 月1000回 → 超過後 $1.50/1000回
EXPO_PUBLIC_CLOUD_VISION_API_KEY=your_cloud_vision_api_key_here

# Android アプリ制限用 SHA-1 証明書フィンガープリント
# 取得方法: expo.dev → プロジェクト → Credentials → Android → Keystore → SHA-1
# 形式: コロンなし・小文字 (例: abcdef1234567890abcdef1234567890abcdef12)
# ※ development と production でキーストアが異なるため SHA-1 も異なる
EXPO_PUBLIC_ANDROID_CERT_SHA1=your_sha1_fingerprint_here_no_colons_lowercase

# Cloud Vision API フロントエンド日次使用上限（デフォルト: 30）
# Google Cloud Console のクォータ設定と組み合わせて使用（フロントエンドは補助的な制限）
# この値を超えると自動的に ML Kit へフォールバックし、ユーザーに通知する
EXPO_PUBLIC_CLOUD_VISION_DAILY_LIMIT=30

# Gemini API キー（フェーズ1: クライアント直接呼び出し）
# 取得方法: https://aistudio.google.com → Get API key → 既存GCPプロジェクトに紐付け
#   → Cloud Console → APIとサービス → ライブラリ → Generative Language API → 有効化
# 無料枠: 1日1,500リクエスト / 毎分15RPM
# フェーズ4以降: Firebase Functions Proxy 経由に移行してサーバーサイドに隠蔽予定
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API フロントエンド日次使用上限（デフォルト: 100）
# 無料枠 1500/日 だが保守的な上限として設定
EXPO_PUBLIC_GEMINI_DAILY_LIMIT=100

# AdMob 広告ユニット ID - Android（本番用）
# 開発中は設定不要（テスト ID が自動使用される）
# 本番リリース時は EAS Secrets で管理:
#   eas secret:create --name EXPO_PUBLIC_ADMOB_BANNER_ID --value ca-app-pub-4083422635947412/8071125037
#   eas secret:create --name EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID --value ca-app-pub-4083422635947412/8597738645
#   eas secret:create --name EXPO_PUBLIC_ADMOB_NATIVE_ID --value ca-app-pub-4083422635947412/8337931922
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-4083422635947412/8071125037
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-4083422635947412/8597738645
EXPO_PUBLIC_ADMOB_NATIVE_ID=ca-app-pub-4083422635947412/8337931922

# AdMob 広告ユニット ID - iOS（本番用）
# 本番リリース時は EAS Secrets で管理:
#   eas secret:create --name EXPO_PUBLIC_ADMOB_IOS_BANNER_ID --value ca-app-pub-4083422635947412/5173526541
#   eas secret:create --name EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID --value ca-app-pub-4083422635947412/3493613363
#   eas secret:create --name EXPO_PUBLIC_ADMOB_IOS_NATIVE_ID --value ca-app-pub-4083422635947412/2930506580
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-4083422635947412/5173526541
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-4083422635947412/3493613363
EXPO_PUBLIC_ADMOB_IOS_NATIVE_ID=ca-app-pub-4083422635947412/2930506580
