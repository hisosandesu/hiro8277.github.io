{
  "expo": {
    "name": "OCR-APP",
    "slug": "react-native-text-ml-kit-text-recognition3",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "カメラにアクセスするための許可が必要です",
          "microphonePermission": "マイクにアクセスするための許可が必要です",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "写真ライブラリにアクセスするための許可が必要です",
          "cameraPermission": "カメラにアクセスするための許可が必要です"
        }
      ],
      "@sentry/react-native",
      "expo-secure-store"
    ],
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/28fb87b6-2976-486c-9461-d475f35335dc"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hiro8277.reactnativetextmlkittextrecognition3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.hiro8277.reactnativetextmlkittextrecognition3"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "28fb87b6-2976-486c-9461-d475f35335dc"
      }
    }
  }
}
